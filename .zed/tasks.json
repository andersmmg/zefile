[
  {
    "label": "Build and restart docker dev",
    "command": "docker compose -f deploy/docker-compose.dev.yml up --build -d --force-recreate zefile",
    "hide": "on_success",
  },
  {
    "label": "Backend dev server",
    "command": "sh -c 'if [ -f deploy/.env ]; then set -a; . deploy/.env; set +a; fi; mkdir -p data config && ZEFILE_APP_URL=http://localhost:8080 ZEFILE_DATA_DIR=$PWD/data ZEFILE_CONFIG_DIR=$PWD/config exec go run ./cmd/zefile'",
  },
  {
    "label": "UI dev server",
    "command": "cd web && pnpm run dev",
  },
  {
    "label": "Go tests",
    "command": "go test ./...",
    "hide": "on_success",
  },
  {
    "label": "UI tests",
    "command": "cd web && pnpm run test",
    "hide": "on_success",
  },
  {
    "label": "Generate sqlc code",
    "command": "make generate",
    "hide": "on_success",
  },
]
